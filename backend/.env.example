# ---- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ---- Auth -------------------------------------------------------------
# Generate a strong random value, e.g.: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-long-random-string

# ---- Database ---------------------------------------------------------
# Dev: leave blank to use the bundled SQLite file at backend/data/ktec.db
# Prod: set DATABASE_URL to your PostgreSQL/MySQL connection string and
# adapt db/init.js (or introduce Prisma/Knex) to use it instead of SQLite.
DATABASE_URL=
SQLITE_PATH=

# ---- Seed (first admin account) ----------------------------------------
SEED_ADMIN_EMAIL=admin@ktec.local
SEED_ADMIN_PASSWORD=ChangeMe@123

# ---- Third-party integrations (optional — leave blank if unused) --------
# Required only if you wire up email notifications for new enquiries.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="K TEC Computer Education <no-reply@kteccomputereducation.com>"

# Required only if you wire up WhatsApp Business API notifications.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
